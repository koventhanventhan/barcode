{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "EduFlow",
    "Audience": "EduFlowClient",
    "SigningKey": "EduFlow_Dev_Signing_Key_Must_Be_At_Least_32_Bytes_Long!",
    "AccessTokenMinutes": 15
  },
  "RateLimiting": {
    "AuthPermitLimit": 60,
    "WindowSeconds": 60
  },
  "Seed": {
    "SuperAdmin": {
      "Email": "superadmin@eduflow.lk",
      "FullName": "EduFlow Super Admin"
    }
  },
  "Diagnostics": {
    "ThrowOnGet": false
  },
  "FileStorage": {
    "Root": "",
    "PublicPath": "/files"
  },
  "AllowedHosts": "*"
}
