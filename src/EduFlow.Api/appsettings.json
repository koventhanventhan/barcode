{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Diagnostics": {
    "ThrowOnGet": false
  },
  "AllowedHosts": "*"
}
