{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "Admino",
    "Audience": "AdminoClient",
    "AccessTokenMinutes": 15
  },
  "RateLimiting": {
    "AuthPermitLimit": 60,
    "WindowSeconds": 60
  },
  "Seed": {
    "SuperAdmin": {
      "FullName": "Admino Super Admin"
    }
  },
  "Demo": {
    "Enabled": false
  },
  "Diagnostics": {
    "ThrowOnGet": false
  },
  "App": {
    "PublicWebUrl": "http://localhost:5173"
  },
  "FileStorage": {
    "Root": "",
    "PublicPath": "/files"
  },
  "Hangfire": {
    "Storage": "InMemory",
    "EnableRecurringJobs": false
  },
  "Sms": {},
  "Notifications": {
    "Email": {
      "Provider": "Fake",
      "FromEmail": "noreply@admino.lk",
      "FromName": "Admino",
      "Smtp": {
        "Host": "",
        "Port": 587,
        "Username": "",
        "Password": "",
        "EnableSsl": true
      },
      "Brevo": {
        "Endpoint": "https://api.brevo.com/v3/smtp/email",
        "ApiKey": ""
      }
    },
    "WhatsApp": {
      "Provider": "Fake",
      "CloudApi": {
        "Endpoint": "https://graph.facebook.com/v19.0",
        "PhoneNumberId": "",
        "AccessToken": ""
      }
    }
  },
  "AllowedHosts": "*"
}
