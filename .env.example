# Copy to .env for local development and docker compose.
# .env is gitignored. These values are for a local SQL Server Express container only.

MSSQL_SA_PASSWORD=EduFlow_Dev_Pass1!
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Server=localhost,1433;Database=EduFlow;User Id=sa;Password=EduFlow_Dev_Pass1!;TrustServerCertificate=True;Encrypt=True
Cors__Origins__0=http://localhost:5173
App__PublicWebUrl=http://localhost:5173
Jwt__SigningKey=EduFlow_Dev_Signing_Key_Must_Be_At_Least_32_Bytes_Long!
SUPERADMIN_EMAIL=superadmin@eduflow.lk
SUPERADMIN_PASSWORD=SuperAdmin@123!
Notifications__Sms__Provider=Fake
Notifications__Sms__NotifyLk__UserId=
Notifications__Sms__NotifyLk__ApiKey=
Notifications__Sms__NotifyLk__SenderId=EduFlow
Notifications__Email__Provider=Fake
Notifications__WhatsApp__Provider=Fake
