# Copy to .env for local development and docker compose.
# .env is gitignored. These values are for a local SQL Server Express container only.

MSSQL_SA_PASSWORD=Admino_Dev_Pass1!
ASPNETCORE_ENVIRONMENT=Development
ConnectionStrings__Default=Server=localhost,1433;Database=Admino;User Id=sa;Password=Admino_Dev_Pass1!;TrustServerCertificate=True;Encrypt=True
Cors__Origins__0=http://localhost:5173
App__PublicWebUrl=http://localhost:5173
AllowedHosts=localhost;127.0.0.1
Jwt__SigningKey=Admino_Dev_Signing_Key_Must_Be_At_Least_32_Bytes_Long!
SUPERADMIN_EMAIL=superadmin@admino.lk
SUPERADMIN_PASSWORD=SuperAdmin@123!
Demo__Enabled=true
Sms__Provider=Fake
Sms__UserId=
Sms__ApiKey=
Sms__SenderId=Admino
Sms__PromotionalSenderId=
Sms__BaseUrl=https://app.notify.lk/api/v1
Sms__TestMode=true
Sms__TestAllowList=
Notifications__Email__Provider=Fake
Notifications__WhatsApp__Provider=Fake
